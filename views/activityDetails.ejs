<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= activity.name %> Dashboard</title>
  <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: Arial, sans-serif;
    }
    .container {
      margin-top: 20px;
    }
    .activity-card {
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
      box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
      padding: 15px;
      margin-bottom: 20px;
      background-color: #fff;
    }
    .activity-card h2 {
      margin-bottom: 10px;
    }
    .badge-legal {
      background-color: #28a745;
    }
    .badge-illegal {
      background-color: #dc3545;
    }
    .nav-custom {
      display: flex;
      justify-content: space-between;
      padding: 10px 20px;
      background-color: #343a40;
      color: #fff;
    }
    .nav-custom a {
      color: #fff;
      text-decoration: none;
      padding: 0 10px;
    }
    .logo {
      display: block;
      margin: 20px auto;
      max-width: 200px;
    }
    .activity-table {
      width: 100%;
    }
    .activity-table th, .activity-table td {
      vertical-align: middle;
      word-wrap: break-word;
      overflow-wrap: break-word;
      white-space: normal; /* Allow text to wrap */
    }
    .greyed-out {
      background-color: #e9ecef;
      color: #6c757d;
    }
    .badge-qualified {
      background-color: #007bff;
    }
    .badge-unqualified {
      background-color: #ffc107;
    }
    #remainingTime {
      font-size: 2.5rem;
      font-weight: bold;
      text-align: center;
      margin: 20px 0;
    }
    .activity-status {
      font-size: 1.25rem;
      font-weight: bold;
      text-align: center;
      margin: 10px 0;
    }
    .card {
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <nav class="nav-custom">
    <a href="/activities"><u>Activities Control</u></a>
    <span>Activity Dashboard</span>
  </nav>
  <img src="/logo.png" class="logo">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <div class="activity-card">
          <h2 id="activityName"><%= activity.name %></h2>
          <p>Activity ID: <%= activity.activityId %></p>
          <p>Time Limit: <%= Math.floor(activity.timeLimit / 60) %> minutes</p>
          <div id="remainingTime">00:00</div>
          <div id="activityStatus" class="activity-status"></div>
          <textarea class="greyed-out form-control" rows="5" readonly>Scoring Type: <%= JSON.stringify(activity.scoreConfig) %></textarea>
          <p>Legality: <span id="activityLegal" class="badge"><%= activity.legal ? 'Legal' : 'Illegal' %></span></p>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card">
          <div class="card-header">
            <h3>Participants</h3>
          </div>
          <div class="card-body">
            <table class="table table-bordered table-hover activity-table">
              <thead class="thead-light">
                <tr>
                  <th>Name</th>
                  <th>Registration ID</th>
                  <th>Start Time</th>
                  <th>End Time</th>
                  <th>Duration</th>
                  <th>Score</th>
                  <th>Rank</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="participantTable">
                <!-- Dynamic content will be inserted here -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script>
    const activityId = '<%= activity.activityId %>';
    const participantsAPI = '/userApi';
    const activityAPI = '/activityAPI';

    const formatTime = (timestamp) => {
      const date = new Date(timestamp);
      return date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
    };

    let remainingTime = 0;
    let interval;

    const tick = () => {
      if (remainingTime <= 0) {
        clearInterval(interval);
        $('#remainingTime').text('');
        $('#activityStatus').text('Expired');
        return;
      }
      remainingTime -= 1000;
      const minutes = Math.floor(remainingTime / 60000);
      const seconds = Math.floor((remainingTime % 60000) / 1000);
      $('#remainingTime').text(`${minutes}:${seconds < 10 ? '0' : ''}${seconds}`);
    };

    const updateActivityData = async () => {
      try {
        const participantsResponse = await fetch(participantsAPI);
        const participantsData = await participantsResponse.json();

        const activityResponse = await fetch(activityAPI);
        const activitiesData = await activityResponse.json();

        const activityData = activitiesData.find(activity => activity.activityId === activityId);

        if (activityData) {
          $('#activityName').text(activityData.name);
          $('#activityLegal').text(activityData.legal ? 'Legal' : 'Illegal')
                             .removeClass('badge-legal badge-illegal')
                             .addClass(activityData.legal ? 'badge-legal' : 'badge-illegal');
          $('#scoreConfig').val(JSON.stringify(activityData.scoreConfig, null, 2));

          let participantsHTML = '';
          const filteredParticipants = participantsData.filter(p => p.activities.some(a => a.activityId === activityId));
          filteredParticipants.sort((a, b) => {
            const activityA = a.activities.find(a => a.activityId === activityId);
            const activityB = b.activities.find(a => a.activityId === activityId);
            return (activityA.rank ?? Infinity) - (activityB.rank ?? Infinity);
          });

          filteredParticipants.forEach(participant => {
            const activity = participant.activities.find(a => a.activityId === activityId);
            const qualified = participant.qualified;
            participantsHTML += `
              <tr>
                <td><a href="../userDetails/${participant.uid}" class="participant-link">${participant.name}</a></td>
                <td>${participant.rid}</td>
                <td>${formatTime(activity.startTime)}</td>
                <td>${formatTime(activity.endTime)}</td>
                <td>${new Date(activity.endTime-activity.startTime).toLocaleTimeString().substring(3,7)}</td>
                <td>${activity.score}</td>
                <td>${activity.rank !== null ? activity.rank : 'N/A'}</td>
                <td><span class="badge ${qualified ? 'badge-qualified' : 'badge-unqualified'}">${qualified ? 'Qualified' : 'Disqualified'}</span></td>
              </tr>
            `;
          });

          $('#participantTable').html(participantsHTML);

          const currentTime = new Date().getTime();
          const startTime = new Date(activityData.startTime).getTime();
          const timeLimit = activityData.timeLimit * 1000;
          const endTime = startTime + timeLimit;
          remainingTime = Math.max(endTime - currentTime, 0);

          const status = !activityData.enabled ? 'Stopped' :
                         remainingTime > 0 ? 'Remaining' : 'Expired';
          $('#activityStatus').text(status);

          if (status === 'Stopped' || status === 'Expired') {
            $('#remainingTime').text('');
            clearInterval(interval);
          } else {
            const minutes = Math.floor(remainingTime / 60000);
            const seconds = Math.floor((remainingTime % 60000) / 1000);
            $('#remainingTime').text(`${minutes}:${seconds < 10 ? '0' : ''}${seconds}`);
            clearInterval(interval);
            interval = setInterval(tick, 1000);
          }
        }
      } catch (error) {
        console.error('Error updating activity data:', error);
      }
    };

    $(document).ready(() => {
      updateActivityData();
      setInterval(updateActivityData, 500);

      // Event delegation for participant links
      $(document).on('click', '.participant-link', function(event) {
        event.preventDefault();
        const href = $(this).attr('href');
        window.location.href = href;
      });
    });
  </script>
</body>
</html>
