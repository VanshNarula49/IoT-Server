<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Color Picker</title>
    <link rel="stylesheet" href="/coloris.css" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        .nav-custom {
            display: flex;
            justify-content: space-between;
            width: 100%;
            padding: 10px 20px;
            background-color: #343a40;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        .nav-custom a {
            color: #fff;
            text-decoration: none;
            padding: 0 10px;
        }

        .color-picker-container {
            text-align: center;
            margin-top: 80px;
        }

        .color-picker-container h1 {
            transition: color 0.3s ease;
        }

        .color-picker-container input[type="hidden"] {
            display: none;
        }
        /* Hide the gradient square */
.coloris .clr-gradient {
    display: none;
}

/* Adjust the layout accordingly */
.coloris .clr-sliders {
    margin-top: 0;
}

    </style>
</head>

<body>
    <nav class="nav-custom">
        <a href="/link"><u>Menu</u></a>
        <span></span>
    </nav>

    <div class="color-picker-container">
        <h1 id="color-heading">Pick a Color</h1>
        <input type="hidden" class="color-field" data-coloris>
    </div>

    <script src="/coloris.js"></script>
    <script>
      Coloris({
    parent: '.color-picker-container',
    wrap: true,
    rtl: false,
    theme: 'large',
    themeMode: 'dark',
    margin: 2,
    format: 'rgb',
    formatToggle: false,
    alpha: false,
    forceAlpha: false,
    swatchesOnly: false,
    focusInput: true,
    selectInput: true,
    clearButton: false,
    closeButton: false,
    inline: true,
    defaultColor: '#ff69b4',
    swatches: [
        '#ff0000', // Red
        '#00ff00', // Green
        '#0000ff', // Blue
        '#ffff00', // Yellow
        '#ffa500', // Orange
        '#ffffff', // White
        '#ff69b4'  // Pink
    ],
    onChange: (color, input) => undefined
});

        var rgb = 'rgb(0,0,0)';
        document.addEventListener('coloris:pick', event => {
            document.body.style.background = event.detail.color;
            rgb = event.detail.color;
            updateHeadingColor();
            sendData();
        });

        function updateHeadingColor() {
            const rgbArray = rgb.match(/\d+/g).map(Number);
            const brightness = Math.sqrt(
                0.299 * (rgbArray[0] * rgbArray[0]) +
                0.587 * (rgbArray[1] * rgbArray[1]) +
                0.114 * (rgbArray[2] * rgbArray[2])
            );

            const colorHeading = document.getElementById('color-heading');
            colorHeading.style.color = brightness > 127.5 ? 'black' : 'white';
        }

        let sendData = async () => {
            await fetch("/rgbcontrol/" + encodeURIComponent(rgb), {
                headers: {
                    'Accept': 'application/json',
                },
                method: "GET",
            })
                .then(function (res) {
                    console.log("sent")
                })
                .catch(function (res) {
                    console.log(res)
                });
        };
    </script>
</body>

</html>
